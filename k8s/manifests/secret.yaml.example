# このファイルをコピーして secret.yaml を作成し、値を埋めてから kubectl apply する。
# secret.yaml は .gitignore 対象のため Git にはコミットしない。
#
#   cp k8s/manifests/secret.yaml.example k8s/manifests/secret.yaml
#   kubectl apply -f k8s/manifests/secret.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: live-tracker-secrets
  namespace: live-tracker
type: Opaque
stringData:
  ANTHROPIC_API_KEY: "your-anthropic-api-key"
  GEMINI_API_KEY: ""
  AI_PROVIDER: "auto"
  NOTION_TOKEN: "your-notion-token"
  NOTION_DATABASE_ID: "your-notion-database-id"
  DISCORD_WEBHOOK_URL: "your-discord-webhook-url"
